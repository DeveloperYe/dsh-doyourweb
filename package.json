{
  "name": "dsh-browser-tabs",
  "version": "0.1.3",
  "description": "Reference and control existing Chrome and Edge tabs from DeepSeek Harness",
  "type": "module",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/SheepofSheep/dsh-browser-tabs.git" },
  "homepage": "https://github.com/SheepofSheep/dsh-browser-tabs#readme",
  "bugs": { "url": "https://github.com/SheepofSheep/dsh-browser-tabs/issues" },
  "main": "lib/host.js",
  "exports": {
    ".": "./lib/host.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": ["lib", "extension", "docs", "cordis.patch.yml", "README.md", "README.zh-CN.md", "LICENSE", "NOTICE"],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "browser-tabs",
    "chrome-extension",
    "edge-extension",
    "cdp",
    "playwright",
    "model-context-protocol",
    "automation"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-input-trigger"
      ],
      "external": ["react", "@deepseek-ai/dsh-client-ui-primitives"]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.mjs",
    "test:browser": "node scripts/test-browser.mjs",
    "verify:dsh": "node scripts/verify-dsh-contract.mjs",
    "prepack": "npm run build",
    "icons": "node scripts/generate-icons.mjs",
    "screenshot": "node scripts/generate-setup-screenshot.mjs"
  },
  "dependencies": {
    "playwright-core": "1.64.0",
    "ws": "8.22.0",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "esbuild": "0.25.11"
  },
  "engines": { "node": ">=22" }
}
